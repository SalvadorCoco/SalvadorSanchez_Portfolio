---
// What I offer, in four plain categories, as a 2 × 2 grid of comic-style
// panels (one column on small screens). All copy lives in
// src/i18n/translations.ts (srv_* keys, es + en) and is applied by the same
// data-i18n mechanism as every other section; the Spanish text rendered here
// comes from that same file, so the markup can't drift from it.
//
// Static apart from one tiny script: the WhatsApp message of the closing link
// follows the active language. No entrance animation.
import T from "../i18n/translations";
import { servicesWhatsApp } from "../lib/contact";

const es = T.es as Record<string, string>;

// Four services, three short "may include" items each (keys srv_N_i1…i3).
// Red / blue alternate like the project plates on the case pages.
const services = [
  { n: 1, tone: "red" },
  { n: 2, tone: "blue" },
  { n: 3, tone: "red" },
  { n: 4, tone: "blue" },
].map((s) => ({ ...s, ids: [1, 2, 3].map((i) => `srv_${s.n}_i${i}`) }));

const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="section services" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <header class="services__head">
      <div class="services__label">
        <div class="sec__eyebrow" data-i18n="srv_eyebrow">{es.srv_eyebrow}</div>
        <span class="services__count" aria-hidden="true">( {pad(services.length)} )</span>
      </div>
      <h2 class="services__title" id="services-title" data-i18n-html="srv_title" set:html={es.srv_title} />
      <p class="services__desc" data-i18n="srv_desc">{es.srv_desc}</p>
    </header>

    <ol class="srv-list" role="list">
      {services.map((s) => (
        <li class={`srv srv--${s.tone}`}>
          <div class="srv__id">
            <span class="srv__num" aria-hidden="true">{pad(s.n)}</span>
            <p class="srv__scope" data-i18n={`srv_${s.n}_scope`}>{es[`srv_${s.n}_scope`]}</p>
          </div>
          <h3 class="srv__title" data-i18n={`srv_${s.n}_title`}>{es[`srv_${s.n}_title`]}</h3>
          <p class="srv__desc" data-i18n={`srv_${s.n}_desc`}>{es[`srv_${s.n}_desc`]}</p>
          <ul class="srv__incl">
            {s.ids.map((key) => (
              <li data-i18n={key}>{es[key]}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div class="srv-cta">
      <p class="srv-cta__text" data-i18n="srv_cta">{es.srv_cta}</p>
      <div class="srv-cta__actions">
        <a
          class="srv-cta__btn"
          href={servicesWhatsApp.es}
          data-wa-es={servicesWhatsApp.es}
          data-wa-en={servicesWhatsApp.en}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-i18n="srv_cta_btn">{es.srv_cta_btn}</span><span aria-hidden="true"> ↗</span>
          <span class="srv-cta__sr"> <span data-i18n="proj_new_tab">{es.proj_new_tab}</span></span>
        </a>
        <a class="srv-cta__alt" href="#contacto" data-i18n="srv_cta_alt">{es.srv_cta_alt}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // The wa.me message is part of the URL, so the link has to follow the active
  // language. Layout.astro only swaps the Contact section's #wspBtn; this does
  // the same for the closing link here (href stays the Spanish one without JS).
  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-wa-es]");
  const sync = () => {
    const lang = document.documentElement.lang === "en" ? "en" : "es";
    links.forEach((a) => {
      const href = a.getAttribute(`data-wa-${lang}`);
      if (href) a.setAttribute("href", href);
    });
  };
  sync();
  new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });
</script>
