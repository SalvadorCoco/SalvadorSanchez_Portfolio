---
const links = [
  { href: "/#proyectos",   key: "nav_projects",   label: "Proyectos" },
  { href: "/#skills",      key: "nav_skills",      label: "Skills" },
  { href: "/#experiencia", key: "nav_experience",  label: "Experiencia" },
  { href: "/#contacto",    key: "nav_contact",     label: "Contacto" },
].map((link, i) => ({ ...link, num: String(i + 1).padStart(2, "0") }));
---

<header class="header" id="site-header">
  <div class="header__left">
    <a href="/" class="header__logo">
      <span class="header__logo-mark">
        <span class="header__bracket">[</span><span class="header__s">S</span><span class="header__bracket">]</span>
      </span>
      <span class="header__logo-name">Salvador Sanchez</span>
    </a>
    <button id="lang-toggle" class="header__lang" aria-label="Cambiar idioma" data-i18n="lang_toggle">EN</button>
  </div>

  <nav class="header__nav-wrap">
    <ul class="header__nav">
      {links.map(({ href, key, label, num }) => (
        <li><a href={href}><span class="header__nav-num">{num}</span><span data-i18n={key}>{label}</span></a></li>
      ))}
    </ul>
  </nav>

  <div class="header__right">
    <div class="header__available">
      <span class="header__available-dot"></span>
      <span data-i18n="hero_badge">Disponible para proyectos</span>
    </div>
    <button class="header__burger" id="burger" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Mobile nav drawer -->
<div class="header__mobile-nav" id="mobile-nav" aria-hidden="true">
  {links.map(({ href, key, label, num }) => (
    <a href={href} class="header__mobile-link"><span class="header__nav-num">{num}</span><span data-i18n={key}>{label}</span></a>
  ))}
  <div class="header__mobile-available">
    <span class="header__available-dot"></span>
    <span data-i18n="hero_badge">Disponible para proyectos</span>
  </div>
</div>

<script>
  const siteHeader = document.getElementById('site-header')!;
  const burger = document.getElementById('burger')!;
  const mobileNav = document.getElementById('mobile-nav')!;

  // Transparent over the hero, solid once you scroll into regular content —
  // so the nav doesn't have to visually match every section's own look.
  function onScroll() {
    siteHeader.classList.toggle('is-scrolled', window.scrollY > 40);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function toggleMenu(open: boolean) {
    burger.classList.toggle('open', open);
    mobileNav.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    mobileNav.setAttribute('aria-hidden', String(!open));
  }

  burger.addEventListener('click', () => {
    toggleMenu(!mobileNav.classList.contains('open'));
  });

  // Close on nav link click
  mobileNav.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => toggleMenu(false));
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!burger.contains(e.target as Node) && !mobileNav.contains(e.target as Node)) {
      toggleMenu(false);
    }
  });

  // ── Active section indicator ────────────────────────
  // A section counts as "current" once it crosses the vertical center of
  // the viewport — every nav link (desktop + mobile) pointing at that
  // section's id gets the active (red) state, everything else clears.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.header__nav a, .header__mobile-link');
  const linksBySection = new Map<string, HTMLAnchorElement[]>();
  navLinks.forEach((a) => {
    const id = a.getAttribute('href')?.split('#')[1];
    if (!id) return;
    if (!linksBySection.has(id)) linksBySection.set(id, []);
    linksBySection.get(id)!.push(a);
  });

  if (linksBySection.size) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((a) => a.classList.remove('active'));
          linksBySection.get(entry.target.id)?.forEach((a) => a.classList.add('active'));
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    linksBySection.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) sectionObserver.observe(section);
    });
  }
</script>
