---
import { getProjectViews } from "../lib/projects";

// React and Next.js lead. Their "used in" lists are NOT hand-written: they
// come from each project's own `tags` in src/content/projects/, so they can't
// drift and can't claim something the data doesn't say. A technology with no
// matching project simply shows no list.
const projects = await getProjectViews();
const usedIn = (tag: string) => projects.filter((p) => p.tags.includes(tag));

const core = [
  { name: "React", kind: "sk_kind_react", kindEs: "Librería de UI", uses: usedIn("React") },
  { name: "Next.js", kind: "sk_kind_next", kindEs: "Framework de React", uses: usedIn("Next.js") },
];

// Everything else, grouped. Same technologies as before, nothing added
// or dropped; only the grouping is new. Items that need translating carry
// both texts (the rest are proper names).
type Item = { es: string; en?: string };
const group = (key: string, es: string, items: Item[]) => ({ key, es, items });

const more = [
  group("sk_cat_lang", "Lenguajes", [{ es: "JavaScript" }, { es: "TypeScript" }]),
  group("sk_cat_style", "Estilos", [{ es: "SCSS" }, { es: "Bootstrap" }]),
  group("sk_cat_framework", "Frameworks", [{ es: "Astro" }]),
  group("sk_cat_tools", "Herramientas", [{ es: "Git" }, { es: "Figma" }, { es: "Docker" }]),
  group("sk_cat_practice", "Prácticas", [
    { es: "UI/UX Design" },
    { es: "Responsive" },
    { es: "Accesibilidad", en: "Accessibility" },
    { es: "Performance" },
  ]),
];

const pad = (n: number) => String(n).padStart(2, "0");
const moreCount = more.reduce((n, g) => n + g.items.length, 0);
---

<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <header class="skills__head">
      <div class="skills__label">
        <div class="sec__eyebrow" data-i18n="sk_eyebrow">stack técnico</div>
        <span class="skills__count" aria-hidden="true">( {pad(core.length + moreCount)} )</span>
      </div>
      <h2 class="skills__title" id="skills-title" data-i18n="sk_title">Las herramientas que uso.</h2>
      <p class="skills__desc" data-i18n="sk_desc">
        No acumulo tecnologías — uso las que tienen sentido para cada proyecto.
      </p>
    </header>

    <div class="sk-zone">
      <h3 class="sk-zone__label" data-i18n="sk_core">Principales</h3>
      <span class="sk-zone__rule" aria-hidden="true"></span>
      <span class="sk-zone__count" aria-hidden="true">( {pad(core.length)} )</span>
    </div>

    <div class="sk-core">
      {core.map((t, i) => (
        <article class="sk-main" aria-labelledby={`sk-${i}`}>
          <span class="sk-main__num" aria-hidden="true">{pad(i + 1)}</span>
          <div class="sk-main__id">
            <h4 class="sk-main__name" id={`sk-${i}`}>{t.name}</h4>
            <p class="sk-main__kind" data-i18n={t.kind}>{t.kindEs}</p>
          </div>
          {t.uses.length > 0 && (
            <div class="sk-main__use">
              <p class="sk-main__use-label" data-i18n="sk_used_in">Usado en</p>
              <ul class="sk-main__projects">
                {t.uses.map((p) => (
                  <li><a href={p.caseHref}>{p.title}</a></li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="sk-plates" aria-hidden="true">
      <span class="sk-plates__bar sk-plates__bar--red"></span>
      <span class="sk-plates__bar sk-plates__bar--blue"></span>
    </div>

    <div class="sk-zone">
      <h3 class="sk-zone__label" data-i18n="sk_more">Más herramientas</h3>
      <span class="sk-zone__rule" aria-hidden="true"></span>
      <span class="sk-zone__count" aria-hidden="true">( {pad(moreCount)} )</span>
    </div>

    <div class="sk-more">
      {more.map((g) => (
        <div class="sk-row">
          <p class="sk-row__cat" data-i18n={g.key}>{g.es}</p>
          <ul class="sk-row__items">
            {g.items.map((item, i) => (
              <li>
                <span data-es={item.es} data-en={item.en ?? item.es}>{item.es}</span>
                {i < g.items.length - 1 && <i class="sk-row__sep" aria-hidden="true">/</i>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
