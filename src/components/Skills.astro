---
const skills = [
  {
    name: "React",
    where_es: '<span>Postas</span> · Proyectos propios',
    where_en: '<span>Postas</span> · Personal projects',
  },
  {
    name: "Next.js",
    where_es: '<span>Portal Municipal</span> · <span>EMOS</span>',
    where_en: '<span>Portal Municipal</span> · <span>EMOS</span>',
  },
  {
    name: "TypeScript",
    where_es: 'Todos los proyectos',
    where_en: 'All projects',
  },
  {
    name: "SCSS",
    where_es: 'Todos los proyectos',
    where_en: 'All projects',
  },
  {
    name: "JavaScript",
    where_es: 'Todos los proyectos',
    where_en: 'All projects',
  },
  {
    name: "Bootstrap",
    where_es: 'Layouts · Prototipos',
    where_en: 'Layouts · Prototypes',
  },
  {
    name: "Astro",
    where_es: 'Este portfolio',
    where_en: 'This portfolio',
  },
];

const methods = ["UI/UX Design", "Responsive", "Accesibilidad", "Performance", "Git", "Figma", "Docker"];
---

<section class="section section--alt skills" id="skills">
  <div class="container">
    <div class="skills__wrap">
      <div>
        <div class="sec__head fu">
          <div class="sec__eyebrow" data-i18n="sk_eyebrow">stack técnico</div>
          <div class="sec__title" data-i18n="sk_title">Las herramientas que uso.</div>
        </div>
        <p class="skills__desc fu d1" data-i18n="sk_desc">
          No acumulo tecnologías — uso las que tienen sentido para cada proyecto.
        </p>
        <div class="skills__methods fu d2">
          {methods.map(m => <span class="meth-tag">{m}</span>)}
        </div>
      </div>

      <div class="skills__grid fu d1">
        {skills.map(({ name, where_es, where_en }) => (
          <div class="sk-card">
            <div class="sk-card__name">{name}</div>
            <div
              class="sk-card__where"
              data-es-html={where_es}
              data-en-html={where_en}
              set:html={where_es}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
