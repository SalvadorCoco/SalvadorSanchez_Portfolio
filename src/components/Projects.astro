---
import { getProjectViews } from "../lib/projects";
import type { ProjectView } from "../lib/projects";
import ProjectActions from "./project/ProjectActions.astro";
import ProjectFacts from "./project/ProjectFacts.astro";
import ProjectShot from "./project/ProjectShot.astro";

// Selected Work is a small editorial publication: three headliners, each in
// its own layout (`feature` in the content frontmatter), then a quieter
// secondary group. Nothing here is gated behind JS or an animation — the
// whole section is in the first paint.
const all = await getProjectViews();
const featured = all.filter((p) => p.feature);
const secondary = all.filter((p) => !p.feature);
const plates = secondary.filter((p) => p.hasCover);
const index = secondary.filter((p) => !p.hasCover);

const pad = (n: number) => String(n).padStart(2, "0");
const words = (name: string) => name.split(" ");
const range =
  secondary.length > 1
    ? `${secondary[0].num} – ${secondary[secondary.length - 1].num}`
    : secondary[0]?.num ?? "";
---

<section class="section projects" id="proyectos">
  <div class="container">
    <header class="projects__head">
      <div class="projects__label">
        <div class="sec__eyebrow" data-i18n="proj_eyebrow">proyectos</div>
        <span class="projects__count" aria-hidden="true">( {pad(all.length)} )</span>
      </div>
      <h2 class="projects__title" data-i18n-html="proj_title">Trabajo real para<br />clientes reales.</h2>
      <p class="projects__intro" data-i18n="proj_intro">
        Proyectos seleccionados: trabajo para el sector público, un producto propio en desarrollo y un proyecto full stack.
      </p>
    </header>

    {featured.map((p) => (
      <article class={`pf pf--${p.feature}`} aria-labelledby={`pf-${p.slug}`}>
        <header class="pf__folio">
          <span class="pf__num" aria-hidden="true">{p.num}</span>
          <span class="pf__rule" aria-hidden="true"></span>
          <span class="pf__kicker" data-es={p.kicker} data-en={p.kicker_en}>{p.kicker}</span>
        </header>

        {p.feature === "showcase" && (
          <>
            <div class="pf__text">
              <h3 class="pf__title" id={`pf-${p.slug}`}>
                <a href={p.caseHref}>
                  {words(p.name).map((w, i, arr) => (<><span class="pf__w">{w}</span>{i < arr.length - 1 && " "}</>))}
                </a>
              </h3>
              {p.metric && p.metric_en && (
                <p class="pf__metric">
                  <span class="pf__metric-value" data-es={p.metric.value} data-en={p.metric_en.value}>{p.metric.value}</span>
                  <span class="pf__metric-label" data-es={p.metric.label} data-en={p.metric_en.label}>{p.metric.label}</span>
                </p>
              )}
              <p class="pf__desc" data-es={p.desc} data-en={p.desc_en}>{p.desc}</p>
              <ProjectFacts p={p} />
            </div>
            <div class="pf__shot"><ProjectShot p={p} tone="red" /></div>
            <div class="pf__actions"><ProjectActions p={p} /></div>
          </>
        )}

        {p.feature === "product" && (
          <>
            <div class="pf__titlebar">
              <h3 class="pf__title pf__title--xl" id={`pf-${p.slug}`}>
                <a href={p.caseHref}>{p.name}</a>
              </h3>
              {p.sub && <span class="pf__tag">{p.sub}</span>}
            </div>
            <div class="pf__text">
              <p class="pf__desc" data-es={p.desc} data-en={p.desc_en}>{p.desc}</p>
              <ProjectFacts p={p} />
            </div>
            <div class="pf__shot"><ProjectShot p={p} tone="blue" /></div>
            <div class="pf__actions"><ProjectActions p={p} /></div>
          </>
        )}

        {p.feature === "poster" && (
          <div class={`pp${p.hasCover || p.layers.length ? "" : " pp--solo"}`}>
            <div class="pp__main">
              <h3 class="pf__title pf__title--poster" id={`pf-${p.slug}`}>
                <a href={p.caseHref}>
                  {words(p.name).map((w, i, arr) => (<><span class="pf__w">{w}</span>{i < arr.length - 1 && " "}</>))}
                </a>
              </h3>
              <p class="pf__desc" data-es={p.desc} data-en={p.desc_en}>{p.desc}</p>
              <ProjectFacts p={p} />
            </div>

            {p.hasCover ? (
              <div class="pp__visual"><ProjectShot p={p} tone="blue" crop="tall" /></div>
            ) : p.layers.length > 0 ? (
              <div class="pp__visual">
                <div class="pl">
                  {p.layers.map((layer, i) => (
                    <>
                      {i > 0 && <div class="pl__link" aria-hidden="true"><span>API</span></div>}
                      <div class={`pl__node pl__node--${i % 2 ? "blue" : "red"}`}>
                        <span class="pl__name">{layer.name}</span>
                        <span class="pl__tech">{layer.tech}</span>
                      </div>
                    </>
                  ))}
                </div>
              </div>
            ) : null}

            <div class="pp__actions"><ProjectActions p={p} /></div>
          </div>
        )}
      </article>
    ))}

    {secondary.length > 0 && (
      <div class="pm-group">
        <div class="pm-head">
          <span class="pm-head__label" data-i18n="proj_more">Más proyectos</span>
          <span class="pm-head__rule" aria-hidden="true"></span>
          <span class="pm-head__count" aria-hidden="true">( {range} )</span>
        </div>

        {plates.length > 0 && (
          <div class="pm-list">
            {plates.map((p: ProjectView, i: number) => (
              <article class={`pm pm--${i % 2 ? "blue" : "red"}`} aria-labelledby={`pm-${p.slug}`}>
                <ProjectShot p={p} tone={i % 2 ? "blue" : "red"} crop={i % 2 ? "tall" : "wide"} />
                <div class="pm__body">
                  <div class="pm__top">
                    <span class="pm__num" aria-hidden="true">{p.num}</span>
                    <h3 class="pm__title" id={`pm-${p.slug}`}><a href={p.caseHref}>{p.name}</a></h3>
                  </div>
                  {p.sub && <p class="pm__sub">{p.sub}</p>}
                  <p class="pm__client">{p.client}</p>
                  <p class="pm__desc" data-es={p.desc} data-en={p.desc_en}>{p.desc}</p>
                  <ProjectFacts p={p} />
                  <ProjectActions p={p} />
                </div>
              </article>
            ))}
          </div>
        )}

        {index.length > 0 && (
          <div class="pi-list">
            {index.map((p) => (
              <article class="pi" aria-labelledby={`pi-${p.slug}`}>
                <span class="pi__num" aria-hidden="true">{p.num}</span>
                <div class="pi__id">
                  <h3 class="pi__title" id={`pi-${p.slug}`}><a href={p.caseHref}>{p.title}</a></h3>
                  <p class="pi__client">{p.client}</p>
                </div>
                <div class="pi__info">
                  <p class="pi__desc" data-es={p.desc} data-en={p.desc_en}>{p.desc}</p>
                  <ProjectFacts p={p} />
                </div>
                <div class="pi__actions"><ProjectActions p={p} /></div>
              </article>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</section>
