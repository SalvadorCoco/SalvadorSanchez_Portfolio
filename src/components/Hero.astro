---
const photoSrc = "/images/fotito.webp";
const stack = ["React", "Next.js", "Astro", "SCSS"];
---

<!--
  Cover, not a scroll story: one compact composition that is complete in
  the first paint. The ~1.3s entrance is pure CSS (see _hero.scss), runs
  once, and is fully skipped under prefers-reduced-motion. No JS here.
  Source order is the mobile reading order; the desktop grid places the
  same elements explicitly.
-->
<section class="hero" id="inicio" aria-labelledby="hero-name">
  <div class="container hero__grid">
    <div class="hero__folio">
      <span class="hero__status">
        <span class="hero__status-dot" aria-hidden="true"></span>
        <span data-i18n="hero_badge">Disponible para proyectos</span>
      </span>
      <span class="hero__rule" aria-hidden="true"></span>
      <span class="hero__where" data-i18n="footer_location">Río Cuarto, Córdoba, Argentina</span>
    </div>

    <h1 class="hero__name" id="hero-name">
      <span class="hero__line"><span class="hero__word">Salvador</span></span>{" "}
      <span class="hero__line"><span class="hero__word">Sanchez</span></span>
    </h1>

    <div class="hero__plates" aria-hidden="true">
      <span class="hero__plate hero__plate--red"></span>
      <span class="hero__plate hero__plate--blue"></span>
    </div>

    <div class="hero__id">
      <p class="hero__role" data-i18n="exp_role_1">Desarrollador Frontend</p>
      <p class="hero__stack">
        {stack.map((tech, i) => (
          <>
            {i > 0 && <i class="hero__stack-sep" aria-hidden="true">/</i>}
            <span>{tech}</span>
          </>
        ))}
      </p>
    </div>

    <div class="hero__portrait">
      <div class="hero__photo" style={`--photo-src:url(${photoSrc})`}>
        <img
          src={photoSrc}
          alt="Salvador Sanchez"
          width="2340"
          height="4160"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <p class="hero__tagline" data-i18n-html="hero_title">
      Interfaces donde <span class="hl">todo</span><br />está donde<br />lo esperás.
    </p>

    <div class="hero__copy">
      <p class="hero__desc" data-i18n="hero_desc">
        Hola, soy Salvador, de Río Cuarto. Hago webs con React y Next.js pensando siempre en quien las va a usar — que no se pierda, que encuentre lo que busca, que vuelva.
      </p>
      <div class="hero__actions">
        <a href="#proyectos" class="hero__btn-primary" data-i18n="hero_cta_primary">Ver proyectos →</a>
        <a href="#contacto" class="hero__btn-secondary" data-i18n="hero_cta_secondary">Hablemos</a>
      </div>
    </div>
  </div>
</section>
