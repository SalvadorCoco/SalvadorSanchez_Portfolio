---
import { getProjectViews } from "../lib/projects";

// All wording below is the existing site copy (src/i18n/translations.ts).
// The current role's paragraph is only split into lead / work / focus so
// each can get its own typographic level; nothing was added or reworded.
//
// The two project links come from the role's own text: it names the
// Portal Municipal and the EMOS site as work done in that job. No other
// entry names a project explicitly, so none gets links.
const projects = await getProjectViews();
const related = ["portal-municipal", "emos"]
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

// Language-neutral (it was the "Next.js, TypeScript, SCSS, Docker." sentence).
const currentStack = ["Next.js", "TypeScript", "SCSS", "Docker"];

const earlier = [
  { date: "exp_date_3", dateEs: "Desde 2021", company: "exp_company_3", companyEs: "Formación autodidacta", role: "exp_role_3", roleEs: "Primeros proyectos propios", desc: "exp_desc_3", descEs: "HTML, CSS, JS y React. Construcción del stack desde cero y primeros clientes reales." },
];

const education = [
  { date: "exp_date_0", dateEs: "2026", company: "exp_company_0", companyEs: "ITEC · Río Cuarto", role: "exp_role_0", roleEs: "Técnico en Desarrollo de Software", desc: "exp_desc_0", descEs: "Me recibí en el ITEC como Técnico en Desarrollo de Software, completando la formación que empecé en 2023." },
  { date: "exp_date_2", dateEs: "2023 — 2025", company: "exp_company_2", companyEs: "ITEC · Río Cuarto", role: "exp_role_2", roleEs: "Formación + Proyectos Freelance", desc: "exp_desc_2", descEs: "Carrera en desarrollo en el ITEC mientras tomaba proyectos reales: Estudio Jurídico Sánchez, sistemas POS y webs institucionales." },
];
---

<section class="section experience" id="experiencia" aria-labelledby="exp-title">
  <div class="container">
    <header class="experience__head">
      <div class="sec__eyebrow" data-i18n="exp_eyebrow">experiencia</div>
      <h2 class="experience__title" id="exp-title" data-i18n="exp_title">Trayectoria laboral.</h2>
      <p class="experience__order">
        <span aria-hidden="true">↓</span> <span data-i18n="exp_order">Más reciente primero</span>
      </p>
    </header>

    <ol class="exp-list">
      <li class="exp-item exp-item--current">
        <p class="exp-item__date" data-i18n="exp_date_1">2025 — Hoy</p>
        <div class="exp-item__body">
          <p class="exp-item__org" data-i18n="exp_company_1">Municipalidad de Río Cuarto</p>
          <h3 class="exp-item__role" data-i18n="exp_role_1">Desarrollador Frontend</h3>
          <p class="exp-item__lead" data-i18n="exp_1_lead">Único desarrollador frontend de la Dirección General de Informática.</p>
          <p class="exp-item__text" data-i18n="exp_1_work">
            Rediseño del Portal Municipal (~65.000 visitantes únicos y ~72.000 sesiones en 30 días, a oct. 2026) y del sitio de EMOS, partiendo de plataformas heredadas sin soporte mobile.
          </p>
          <p class="exp-item__text" data-i18n="exp_1_focus">Foco en accesibilidad y experiencia del vecino.</p>
        </div>

        <!-- Desktop: sits in the date rail under the date. Mobile: after the body. -->
        <div class="exp-item__meta">
          <div class="exp-item__meta-group">
            <p class="exp-item__meta-label">Stack</p>
            <p class="exp-item__stack">
              {currentStack.map((tech, i) => (
                <>
                  {i > 0 && <i class="exp-item__sep" aria-hidden="true">/</i>}
                  <span>{tech}</span>
                </>
              ))}
            </p>
          </div>

          {related.length > 0 && (
            <div class="exp-item__meta-group">
              <p class="exp-item__meta-label" data-i18n="proj_eyebrow">proyectos</p>
              <p class="exp-item__related">
                {related.map((p) => (
                  <a href={p.caseHref}>{p.name}</a>
                ))}
              </p>
            </div>
          )}
        </div>
      </li>

      {earlier.map((e) => (
        <li class="exp-item">
          <p class="exp-item__date" data-i18n={e.date}>{e.dateEs}</p>
          <div class="exp-item__body">
            <p class="exp-item__org" data-i18n={e.company}>{e.companyEs}</p>
            <h3 class="exp-item__role" data-i18n={e.role}>{e.roleEs}</h3>
            <p class="exp-item__text" data-i18n={e.desc}>{e.descEs}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="exp-zone">
      <h3 class="exp-zone__label" data-i18n="exp_edu_title">Formación</h3>
      <span class="exp-zone__rule" aria-hidden="true"></span>
    </div>

    <ul class="exp-edu">
      {education.map((e) => (
        <li class="exp-edu__item">
          <p class="exp-edu__date" data-i18n={e.date}>{e.dateEs}</p>
          <div class="exp-edu__body">
            <h4 class="exp-edu__role" data-i18n={e.role}>{e.roleEs}</h4>
            <p class="exp-edu__org" data-i18n={e.company}>{e.companyEs}</p>
            <p class="exp-edu__text" data-i18n={e.desc}>{e.descEs}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="exp-cv">
      <div class="exp-cv__text">
        <p class="exp-cv__title">Curriculum Vitae</p>
        <p class="exp-cv__sub" data-i18n="exp_cv_sub">Experiencia, formación y proyectos detallados en PDF.</p>
      </div>
      <a
        href="/SalvadorSanchezCV.pdf"
        download
        class="exp-cv__btn"
        data-i18n="exp_cv_btn"
        data-cv-es="/SalvadorSanchezCV.pdf"
        data-cv-en="/SalvadorSanchezCV_EN.pdf"
      >Descargar CV</a>
    </div>
  </div>
</section>
