---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ProjectLayers from "../../components/project/ProjectLayers.astro";
import { getCollection } from "astro:content";
import "../../styles/main.scss";

const entries = await getCollection("projects");
entries.sort((a, b) => a.id.localeCompare(b.id));
const projects = entries.map((entry) => ({ slug: entry.slug, ...entry.data }));

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug)!;
const currentIndex = projects.findIndex((p) => p.slug === slug);
const prev = projects[currentIndex - 1] ?? null;
const next = projects[currentIndex + 1] ?? null;

const hasScreenshots = project.screenshots.length > 0;
const multipleScreenshots = project.screenshots.length > 1;

// "Postas · Sistema POS" → big name + a smaller second line (same split the
// home page uses). The whole title stays inside the <h1>.
const [name, ...subParts] = project.title.split(" · ");
const sub = subParts.join(" · ");

// Same label the home page puts next to the number.
const kicker = project.kicker ?? project.client;
const kickerEn = project.kicker_en ?? kicker;

// The cover is chosen from data that already exists: a screenshot when there
// is one, the real front/back layers when there are no screenshots, and a
// purely typographic cover otherwise. No per-slug exceptions.
const variant = hasScreenshots ? "shot" : project.layers?.length ? "layers" : "type";

// Print-plate colour for the frame and the result panel: red on odd project
// numbers, blue on even ones (as on the home page).
const tone = Number(project.num) % 2 ? "red" : "blue";

// Same visibility rule as before: no links for private projects, and links
// flagged `inactive` stay hidden.
const links = project.private ? [] : project.links.filter((l) => !l.inactive);
---

<Layout title={`${project.title} — Salvador Sanchez`} description={project.desc}>
  <Header />

  <main class={`proj-page proj-page--${tone}`}>

    <div class="proj-page__breadcrumb">
      <div class="container">
        <a href="/#proyectos" class="proj-page__back" data-i18n="proj_back">← Volver a proyectos</a>
      </div>
    </div>

    <!-- Cover -->
    <section class={`proj-hero proj-hero--${variant}`}>
      <div class="container">
        <div class="proj-hero__grid">
          <p class="proj-hero__folio">
            <span class="proj-hero__num" aria-hidden="true">{project.num}</span>
            <span class="proj-hero__kicker" data-es={kicker} data-en={kickerEn}>{kicker}</span>
          </p>

          <h1 class="proj-hero__title">
            <span class="proj-hero__name">{name}</span>
            {sub && (
              <span class="proj-hero__sub"><span class="proj-page__sr"> · </span>{sub}</span>
            )}
          </h1>

          <p
            class="proj-hero__lead"
            data-es={project.desc}
            data-en={project.desc_en ?? project.desc}
          >{project.desc}</p>

          <dl class="proj-meta">
            <div class="proj-meta__item">
              <dt data-i18n="proj_client">Cliente</dt>
              <dd>{project.client}</dd>
            </div>

            <div class="proj-meta__item">
              <dt>Stack</dt>
              <dd class="proj-meta__stack">
                {project.tags.map((tag, i) => (
                  <>
                    {i > 0 && <i class="proj-meta__sep" aria-hidden="true">/</i>}
                    <span>{tag}</span>
                  </>
                ))}
              </dd>
            </div>

            {links.length > 0 && (
              <div class="proj-meta__item proj-meta__item--links">
                <dt class="proj-page__sr">Links</dt>
                <dd class="proj-links">
                  {links.map(({ href, label, type }) => (
                    <a
                      href={href}
                      target="_blank"
                      rel="noopener"
                      class={type === "live" ? "proj-links__live" : "proj-links__other"}
                    >{label}<span class="proj-page__sr"> <span data-i18n="proj_new_tab">(se abre en una pestaña nueva)</span></span></a>
                  ))}
                </dd>
              </div>
            )}

            {project.demo && (
              <div class="proj-meta__item">
                <dt>Demo</dt>
                <dd>
                  {project.demo.pending || !project.demo.href ? (
                    <span
                      class="proj-demo proj-demo--pending"
                      data-es={`🎥 ${project.demo.label} (próximamente)`}
                      data-en={`🎥 ${project.demo.label_en || project.demo.label} (coming soon)`}
                    >🎥 {project.demo.label} (próximamente)</span>
                  ) : (
                    <a
                      href={project.demo.href}
                      target="_blank"
                      rel="noopener"
                      class="proj-links__other"
                      data-es={`🎥 ${project.demo.label}`}
                      data-en={`🎥 ${project.demo.label_en || project.demo.label}`}
                    >🎥 {project.demo.label}</a>
                  )}
                </dd>
              </div>
            )}
          </dl>

          {variant === "layers" && (
            <div class="proj-hero__visual">
              <ProjectLayers layers={project.layers!} />
            </div>
          )}

          {variant === "type" && (
            <p class="proj-hero__bignum" aria-hidden="true">{project.num}</p>
          )}
        </div>
      </div>
    </section>

    <!-- Screenshots -->
    {hasScreenshots && (
      <section class="proj-stage">
        <div class="container">
          {multipleScreenshots ? (
            <div class="sc-carousel" id="sc-carousel">
              <div class="sc-carousel__track">
                {project.screenshots.map((src, i) => (
                  <div class={`sc-carousel__slide${i === 0 ? " active" : ""}`} data-index={i}>
                    <figure class="proj-shot">
                      <img
                        src={src}
                        alt={`${project.title} — captura ${i + 1}`}
                        loading={i === 0 ? "eager" : "lazy"}
                      />
                    </figure>
                  </div>
                ))}
              </div>

              <div class="sc-carousel__controls">
                <button class="sc-carousel__btn" id="sc-prev" aria-label="Anterior">←</button>
                <div class="sc-carousel__dots" id="sc-dots">
                  {project.screenshots.map((_, i) => (
                    <button
                      class={`sc-carousel__dot${i === 0 ? " active" : ""}`}
                      data-index={i}
                      aria-label={`Captura ${i + 1}`}
                    />
                  ))}
                </div>
                <button class="sc-carousel__btn" id="sc-next" aria-label="Siguiente">→</button>
              </div>
            </div>
          ) : (
            <figure class="proj-shot">
              <img
                src={project.screenshots[0]}
                alt={`${project.title} — captura principal`}
                loading="eager"
              />
            </figure>
          )}
        </div>
      </section>
    )}

    <!-- Case -->
    <section class="proj-body">
      <div class="container">

        <div class="pb">
          <div class="pb__rail">
            <span class="pb__num" aria-hidden="true">01</span>
            <h2 class="pb__title" data-i18n="proj_context_title">Contexto</h2>
          </div>
          <div class="pb__content">
            <p
              class="pb__text"
              data-es={project.context}
              data-en={project.context_en ?? project.context}
            >{project.context}</p>
          </div>
        </div>

        <div class="pb">
          <div class="pb__rail">
            <span class="pb__num" aria-hidden="true">02</span>
          </div>
          <div class="pb__content pb__duo">
            <div class="pb__col pb__col--problem">
              <div class="pb__label" data-i18n="proj_problem">Problema</div>
              <p
                class="pb__text"
                data-es={project.problem}
                data-en={project.problem_en ?? project.problem}
              >{project.problem}</p>
            </div>
            <div class="pb__col pb__col--solution">
              <div class="pb__label" data-i18n="proj_solution">Solución</div>
              <p
                class="pb__text"
                data-es={project.solution}
                data-en={project.solution_en ?? project.solution}
              >{project.solution}</p>
            </div>
          </div>
        </div>

        <div class="pb">
          <div class="pb__rail">
            <span class="pb__num" aria-hidden="true">03</span>
            <h2 class="pb__title" data-i18n="proj_process_title">Proceso</h2>
          </div>
          <div class="pb__content">
            <p
              class="pb__text"
              data-es={project.process}
              data-en={project.process_en ?? project.process}
            >{project.process}</p>
          </div>
        </div>

        <div class="pb pb--result">
          <div class="pb__rail">
            <span class="pb__num" aria-hidden="true">04</span>
          </div>
          <div class="pb__content">
            <div class="pb__panel">
              <div class="pb__label pb__label--red" data-i18n="proj_result_label">Resultado</div>
              <p
                class="pb__result"
                data-es={project.result}
                data-en={project.result_en ?? project.result}
              >{project.result}</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <nav class="proj-nav">
      <div class="container">
        <div class="proj-nav__inner">
          {prev ? (
            <a href={`/proyectos/${prev.slug}`} class="proj-nav__link proj-nav__link--prev">
              <span class="proj-nav__dir" data-i18n="proj_prev">← Anterior</span>
              <span class="proj-nav__name">{prev.title}</span>
            </a>
          ) : <div />}
          {next ? (
            <a href={`/proyectos/${next.slug}`} class="proj-nav__link proj-nav__link--next">
              <span class="proj-nav__dir" data-i18n="proj_next">Siguiente →</span>
              <span class="proj-nav__name">{next.title}</span>
            </a>
          ) : <div />}
        </div>
      </div>
    </nav>

  </main>
</Layout>

<script>
  const carousel = document.getElementById('sc-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll<HTMLElement>('.sc-carousel__slide');
    const dots   = carousel.querySelectorAll<HTMLElement>('.sc-carousel__dot');
    let current  = 0;

    function goTo(n: number) {
      slides[current].classList.remove('active');
      dots[current].classList.remove('active');
      current = ((n % slides.length) + slides.length) % slides.length;
      slides[current].classList.add('active');
      dots[current].classList.add('active');
    }

    document.getElementById('sc-prev')?.addEventListener('click', () => goTo(current - 1));
    document.getElementById('sc-next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });
  }
</script>
