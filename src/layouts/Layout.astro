      function applyLang(lang) {
        var t = window.__T[lang];
        if (!t) return;
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);
        localStorage.setItem('portfolio-lang', lang);

        // Static UI keys → textContent
        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          if (t[key] !== undefined) el.textContent = t[key];
        });

        // Static UI keys → innerHTML (for <br> etc.)
        document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-html');
          if (t[key] !== undefined) el.innerHTML = t[key];
        });

        // Input placeholders
        document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-ph');
          if (t[key] !== undefined) el.setAttribute('placeholder', t[key]);
        });

        // Dynamic content with explicit es/en text (e.g. project descriptions)
        document.querySelectorAll('[data-es]').forEach(function(el) {
          var text = lang === 'en' ? el.getAttribute('data-en') : el.getAttribute('data-es');
          if (text !== null) el.textContent = text;
        });

        // Dynamic content with explicit es/en HTML (e.g. skills with highlight spans)
        document.querySelectorAll('[data-es-html]').forEach(function(el) {
          var html = lang === 'en' ? el.getAttribute('data-en-html') : el.getAttribute('data-es-html');
          if (html !== null) el.innerHTML = html;
        });
      }

      window.__applyLang = applyLang;

      document.addEventListener('DOMContentLoaded', function() {
        var lang = document.documentElement.getAttribute('data-lang') || 'es';
        applyLang(lang);

        document.getElementById('lang-toggle')?.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-lang') || 'es';
          applyLang(current === 'es' ? 'en' : 'es');
        });

        document.getElementById('theme-toggle')?.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          var next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('portfolio-theme', next);
        });
      });
    </script>
