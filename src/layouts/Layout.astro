          exp_order: "Most recent first",
          exp_edu_title: "Education",
          ct_eyebrow: "contact",
          ct_title: "Want to talk about<br />your project?",
          ct_intro: "I work with people who value things that work well. If your project needs an interface anyone can use without help, reach out.",
          ct_wsp_title: "Message me on WhatsApp",
          ct_wsp_desc: "I reply fast. Tell me about your project and I'll help you out.",
          ct_wsp_btn: "Open WhatsApp →",
          nav_projects: "Projects", nav_skills: "Skills",
          nav_experience: "Experience", nav_contact: "Contact",
          header_cta: "Hire me",
          proj_back: "← Back to projects",
          proj_client: "Client", proj_year: "Year",
          proj_context_title: "Context", proj_process_title: "Process",
          proj_result_label: "Result",
          proj_prev: "← Previous", proj_next: "Next →",
          lang_toggle: "ES",
          footer_location: "Río Cuarto, Córdoba, Argentina",
        }
      };

      function applyLang(lang) {
        var t = window.__T[lang];
        if (!t) return;
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);
        localStorage.setItem('portfolio-lang', lang);

        // Static UI keys → textContent
        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          if (t[key] !== undefined) el.textContent = t[key];
        });

        // Static UI keys → innerHTML (for <br> etc.)
        document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-html');
          if (t[key] !== undefined) el.innerHTML = t[key];
        });

        // Input placeholders
        document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-ph');
          if (t[key] !== undefined) el.setAttribute('placeholder', t[key]);
        });

        // Dynamic content with explicit es/en text (e.g. project descriptions)
        document.querySelectorAll('[data-es]').forEach(function(el) {
          var text = lang === 'en' ? el.getAttribute('data-en') : el.getAttribute('data-es');
          if (text !== null) el.textContent = text;
        });

        // Dynamic content with explicit es/en HTML (e.g. skills with highlight spans)
        document.querySelectorAll('[data-es-html]').forEach(function(el) {
          var html = lang === 'en' ? el.getAttribute('data-en-html') : el.getAttribute('data-es-html');
          if (html !== null) el.innerHTML = html;
        });

        // WhatsApp button: switch pre-filled message by language
        var wspBtn = document.getElementById('wspBtn');
        if (wspBtn) {
          var wspHref = wspBtn.getAttribute('data-wsp-' + lang);
          if (wspHref) wspBtn.setAttribute('href', wspHref);
        }

        // CV download: switch PDF by language
        var cvBtn = document.querySelector('[data-cv-es]');
        if (cvBtn) {
          var cvHref = lang === 'en' ? cvBtn.getAttribute('data-cv-en') : cvBtn.getAttribute('data-cv-es');
          if (cvHref) cvBtn.setAttribute('href', cvHref);
        }
      }

      window.__applyLang = applyLang;

      document.addEventListener('DOMContentLoaded', function() {
        var lang = document.documentElement.getAttribute('data-lang') || 'es';
        applyLang(lang);

        document.getElementById('lang-toggle')?.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-lang') || 'es';
          applyLang(current === 'es' ? 'en' : 'es');
        });

        document.getElementById('theme-toggle')?.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          var next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('portfolio-theme', next);
        });
      });
    </script>
  </body>
</html>
