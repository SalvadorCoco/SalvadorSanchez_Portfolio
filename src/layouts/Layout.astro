---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Salvador Sanchez — Frontend Developer",
  description = "Hago webs con React y Next.js pensando siempre en quien las va a usar — funcionales, claras y fáciles de navegar.",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- Detect language + theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        // ── Language detection ──────────────────────────
        var LATAM = ['ar','mx','cl','co','pe','ve','bo','uy','py','ec','gt','hn','sv','ni','cr','pa','do','cu','pr'];
        var savedLang = localStorage.getItem('portfolio-lang');
        var lang;
        if (savedLang) {
          lang = savedLang;
        } else {
          var loc = (navigator.language || '').toLowerCase();
          var parts = loc.split('-');
          var l = parts[0];
          var c = parts[1] || '';
          lang = (l === 'es' && (!c || LATAM.indexOf(c) > -1)) ? 'es' : 'en';
        }
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);

        // ── Theme detection ─────────────────────────────
        var savedTheme = localStorage.getItem('portfolio-theme');
        var theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      window.__T = {
        es: {
