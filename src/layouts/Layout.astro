---
import T from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Salvador Sanchez — Frontend Developer",
  description = "Hago webs con React y Next.js pensando siempre en quien las va a usar — funcionales, claras y fáciles de navegar.",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Detect language before paint to avoid flash -->
    <script is:inline>
      (function () {
        // ── Language detection ──────────────────────────
        var LATAM = ['ar','mx','cl','co','pe','ve','bo','uy','py','ec','gt','hn','sv','ni','cr','pa','do','cu','pr'];
        var savedLang = localStorage.getItem('portfolio-lang');
        var lang;
        if (savedLang) {
          lang = savedLang;
        } else {
          var loc = (navigator.language || '').toLowerCase();
          var parts = loc.split('-');
          var l = parts[0];
          var c = parts[1] || '';
          lang = (l === 'es' && (!c || LATAM.indexOf(c) > -1)) ? 'es' : 'en';
        }
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script define:vars={{ T }}>
      // Single source of truth: this object is injected server-side from
      // src/i18n/translations.ts (see /docs/PROJECT_ARCHITECTURE.md — this
      // used to be a hand-duplicated copy that could drift from the typed
      // file; now there is only one place to edit copy).
      window.__T = T;

      function applyLang(lang) {
        var t = window.__T[lang];
        if (!t) return;
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);
        localStorage.setItem('portfolio-lang', lang);

        // Static UI keys → textContent
        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          if (t[key] !== undefined) el.textContent = t[key];
        });

        // Static UI keys → innerHTML (for <br> etc.)
        document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-html');
          if (t[key] !== undefined) el.innerHTML = t[key];
        });

        // Input placeholders
        document.querySelectorAll('[data-i18n-ph]').forEach(function(el) {
          var key = el.getAttribute('data-i18n-ph');
          if (t[key] !== undefined) el.setAttribute('placeholder', t[key]);
        });

        // Dynamic content with explicit es/en text (e.g. project descriptions)
        document.querySelectorAll('[data-es]').forEach(function(el) {
          var text = lang === 'en' ? el.getAttribute('data-en') : el.getAttribute('data-es');
          if (text !== null) el.textContent = text;
        });

        // Dynamic content with explicit es/en HTML (e.g. skills with highlight spans)
        document.querySelectorAll('[data-es-html]').forEach(function(el) {
          var html = lang === 'en' ? el.getAttribute('data-en-html') : el.getAttribute('data-es-html');
          if (html !== null) el.innerHTML = html;
        });

        // WhatsApp button: switch pre-filled message by language
        var wspBtn = document.getElementById('wspBtn');
        if (wspBtn) {
          var wspHref = wspBtn.getAttribute('data-wsp-' + lang);
          if (wspHref) wspBtn.setAttribute('href', wspHref);
        }

        // CV download: switch PDF by language
        var cvBtn = document.querySelector('[data-cv-es]');
        if (cvBtn) {
          var cvHref = lang === 'en' ? cvBtn.getAttribute('data-cv-en') : cvBtn.getAttribute('data-cv-es');
          if (cvHref) cvBtn.setAttribute('href', cvHref);
        }
      }

      window.__applyLang = applyLang;

      document.addEventListener('DOMContentLoaded', function() {
        var lang = document.documentElement.getAttribute('data-lang') || 'es';
        applyLang(lang);

        document.getElementById('lang-toggle')?.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-lang') || 'es';
          applyLang(current === 'es' ? 'en' : 'es');
        });
      });

      // ── Card spotlight ────────────────────────────────
      // One delegated listener feeds the cursor position to whichever
      // card is under it; the CSS in @mixin spotlight does the rest.
      (function () {
        var SEL = '.proj-card, .clink, .wsp-card, .cv-box, .formacion__item';
        if (window.matchMedia('(hover: none)').matches) return;

        document.addEventListener('mousemove', function (e) {
          var card = e.target.closest && e.target.closest(SEL);
          if (!card) return;
          var r = card.getBoundingClientRect();
          card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          card.style.setProperty('--my', (e.clientY - r.top) + 'px');
        }, { passive: true });
      })();
    </script>
  </body>
</html>
