        },
        en: {
          hero_badge: "Available for projects",
          hero_title: 'Interfaces where <span class="hl">everything</span><br />is right where<br />you expect it.',
          hero_desc: "Hi, I'm Salvador from Río Cuarto, Argentina. I build websites with React and Next.js, always thinking about the people who'll use them — functional, clear, easy to find your way around.",
